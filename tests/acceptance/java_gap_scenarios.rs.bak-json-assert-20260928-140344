#![cfg(feature = "postgres-acceptance")]
#[path = "../support/acceptance_support.rs"]
mod support;
use axum::body::to_bytes;

fn assert_json_number(value: &serde_json::Value, expected: &str) {
    assert!(value.is_number(), "expected JSON number, got: {value}");
    assert_eq!(value.to_string(), expected);
}
use serde_json::json;
use support::{build_app, cashback_for, postgres_context, request};

#[tokio::test]
async fn category_rates_cover_groceries_and_fuel() -> Result<(), Box<dyn std::error::Error>> {
    let ctx = postgres_context().await?;
    let app = build_app(ctx.pool.clone());
    request(
        app.clone(),
        "POST",
        "/api/categories",
        json!({"mcc":"5411","name":"Groceries","cashbackRate":"0.02"}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/categories",
        json!({"mcc":"5541","name":"Fuel","cashbackRate":"0.01"}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/merchants",
        json!({"name":"Grocer","partner":true}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/merchants",
        json!({"name":"FuelCo","partner":true}),
    )
    .await?;
    request(app.clone(),"POST","/api/purchases",json!({"customerId":"cust-g","merchantName":"Grocer","mcc":"5411","amount":"100.00","purchasedAt":"2026-05-01T10:00:00Z"})).await?;
    request(app.clone(),"POST","/api/purchases",json!({"customerId":"cust-f","merchantName":"FuelCo","mcc":"5541","amount":"100.00","purchasedAt":"2026-05-01T10:00:00Z"})).await?;
    let g = cashback_for(build_app(ctx.pool.clone()), "cust-g").await?;
    let f = cashback_for(build_app(ctx.pool.clone()), "cust-f").await?;
    assert_json_number(g[0]["cashbackAmount"], "2.00");
    assert_json_number(f[0]["cashbackAmount"], "1.00");
    Ok(())
}

#[tokio::test]
async fn threshold_exact_and_above_cases_match_java_acceptance()
-> Result<(), Box<dyn std::error::Error>> {
    let ctx = postgres_context().await?;
    let app = build_app(ctx.pool.clone());
    request(
        app.clone(),
        "POST",
        "/api/categories",
        json!({"mcc":"5411","name":"Groceries","cashbackRate":"0.02"}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/merchants",
        json!({"name":"AtMart","partner":true}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/merchants",
        json!({"name":"BigMart","partner":true}),
    )
    .await?;
    request(app.clone(),"POST","/api/purchases",json!({"customerId":"cust-at","merchantName":"AtMart","mcc":"5411","amount":"1.00","purchasedAt":"2026-05-01T10:00:00Z"})).await?;
    request(app,"POST","/api/purchases",json!({"customerId":"cust-big","merchantName":"BigMart","mcc":"5411","amount":"25.00","purchasedAt":"2026-05-01T10:00:00Z"})).await?;
    let at = cashback_for(build_app(ctx.pool.clone()), "cust-at").await?;
    let big = cashback_for(build_app(ctx.pool.clone()), "cust-big").await?;
    assert_json_number(at[0]["cashbackAmount"], "0.02");
    assert_json_number(big[0]["cashbackAmount"], "0.50");
    Ok(())
}

#[tokio::test]
