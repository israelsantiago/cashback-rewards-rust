-> Result<(), Box<dyn std::error::Error>> {
    let ctx = postgres_context().await?;
    let app = build_app(ctx.pool.clone());
    request(
        app.clone(),
        "PUT",
        "/api/categories/default-rate",
        json!({"cashbackRate":"0.005"}),
    )
    .await?;
    request(
        app.clone(),
        "POST",
        "/api/merchants",
        json!({"name":"PennySaver","partner":true}),
    )
    .await?;
    request(app,"POST","/api/purchases",json!({"customerId":"cust-tiny","merchantName":"PennySaver","mcc":"9999","amount":"5.00","purchasedAt":"2026-05-01T10:00:00Z"})).await?;
    let v = cashback_for(build_app(ctx.pool.clone()), "cust-tiny").await?;
