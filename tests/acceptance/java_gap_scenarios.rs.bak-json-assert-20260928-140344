    Ok(())
}

#[tokio::test]
async fn product_total_returns_zero_count_when_empty() -> Result<(), Box<dyn std::error::Error>> {
    let ctx = postgres_context().await?;
    let r = request(
        build_app(ctx.pool),
        "GET",
        "/api/products/Travel/cashback-total",
        json!({}),
    )
    .await?;
    let body = to_bytes(r.into_body(), usize::MAX).await?;
    let v: serde_json::Value = serde_json::from_slice(&body)?;
    assert_eq!(v["product"], "Travel");
    assert_json_number(v["totalCashback"], "0.00");
    assert_eq!(v["recordCount"], 0);
    Ok(())
}
